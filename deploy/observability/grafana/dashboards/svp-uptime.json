    {
      "type": "timeseries",
      "title": "Probe success",
      "description": "Blackbox exporter probes from inside the cluster (compose: its own network) through the public path; it shares region, VPC and NAT with the system, so it does not measure from the users' geography. Minimum over the targets of a probe; 0 is a failed probe. TLS and status failures show here as 0 too.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "min by (probe) (probe_success{job=\"blackbox-http\", probe=~\"$probe\"})",
          "legendFormat": "{{probe}}",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
