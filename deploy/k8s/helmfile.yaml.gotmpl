# The releases of the dev path (`make k8s-up`, install.sh), for helmfile: every component of argocd/apps/components.json
# of the clone of svp-gitops with its values files of base/ (never envs/), so both paths install the same charts,
# versions and base values from one list. Left out: gitopsOnly (External Secrets Operator: the dev path's Secrets come
# from .env) and a component whose platforms leave out k3d.

# Each release carries its wave as label wave and needs every release of the wave before it, so helmfile installs the
# waves in order; dev_helmfile of deploy/k8s/rotate.sh runs one release at a time (--concurrency 1), as Argo CD's waves
# do not need but this machine's memory does. Release reloader also needs argo-rollouts: its chart reads whether
# Rollouts exist.

# The GitOps root reads platforms/k3d/ too, this file base/ alone: a file under platforms/k3d/ would make this path
# install something other than what Argo CD runs without a word, so the render fails on one (but README.md and
# svp-cluster.yaml holding externalSecrets alone: where the Secrets come from is the GitOps path's own).

# State values, given by dev_helmfile on the command line or in a temporary file, never in a file of this repository:
#   gitopsDir, nodeArch   the clone of svp-gitops (gitops_dir of lib.sh), amd64 or arm64; required
#   images                <release>: {repository, tag, digest} for each release of chart svp-service
#   pgServerName          the archive generation of the running Cluster svp-pg; unset on a Cluster without one

# Presync and postsync call `deploy/k8s/install.sh hook <event> <release> <namespace> <kind> <canaryRoute> <failed>`; a
# failing hook or release stops helmfile before the next wave. Neither runs for `helmfile template`.
# Design notes: docs/reference/k8s.md.
{{- $gitops := .StateValues | get "gitopsDir" "" | required "state value gitopsDir (the clone of svp-gitops) is not set: run make k8s-up, or pass --state-values-set gitopsDir=<clone>" }}
{{- $arch := .StateValues | get "nodeArch" "" }}
{{- if not (has $arch (list "amd64" "arm64")) }}
{{- fail (printf "state value nodeArch is '%s': amd64 or arm64, the architecture of the nodes of cluster svp" $arch) }}
{{- end }}
{{- $images := .StateValues | get "images" dict }}
{{- $pgServer := .StateValues | get "pgServerName" "" }}
{{- $platform := printf "%s/platforms/k3d" $gitops }}
{{- if isDir $platform }}
{{- range $f := readDir $platform }}
{{- $name := base $f }}
{{- if eq $name "svp-cluster.yaml" }}
{{- $keys := readFile (printf "%s/%s" $platform $name) | fromYaml | keys | sortAlpha | join "," }}
{{- if ne $keys "externalSecrets" }}
{{- fail (printf "platforms/k3d/svp-cluster.yaml of svp-gitops sets %s: on k3d the GitOps root reads it and the dev path does not, which may hold externalSecrets alone (the GitOps path's Secrets); put values of k3d into base/, which both paths read" $keys) }}
{{- end }}
{{- else if ne $name "README.md" }}
{{- fail (printf "platforms/k3d/%s of svp-gitops is read on k3d by the GitOps root but not by the dev path: put values of k3d into base/, which both paths read" $name) }}
{{- end }}
{{- end }}
{{- end }}
{{- $all := readFile (printf "%s/argocd/apps/components.json" $gitops) | fromYaml }}
{{- $dev := list }}
{{- range $c := $all.components }}
{{- if and (not (get "gitopsOnly" false $c)) (or (not (hasKey $c "platforms")) (has "k3d" $c.platforms)) }}
{{- $dev = append $dev $c }}
{{- end }}
{{- end }}

helmDefaults:
  kubeContext: k3d-svp
  # Every namespace exists before its release (install.sh and chart svp-cluster make them): Helm 4's server-side
  # --create-namespace would apply a Namespace under the field manager every release shares and remove svp-cluster's
  # labels.
  createNamespace: false
  # The next wave relies on this one's CRDs, webhooks and pods being ready (cert-manager's startupapicheck hook, for
  # one, returns only once its webhook answers), so no blind sleep is needed between waves.
  wait: true
  timeout: 600

repositories:
{{- range $c := $dev }}
{{- if and (get "repo" "" $c) (not (hasPrefix "oci://" (get "repo" "" $c))) }}
  - name: {{ $c.name }}
    url: {{ $c.repo }}
{{- end }}
{{- end }}

releases:
{{- range $c := $dev }}
{{- $prev := -1 }}
{{- range $d := $dev }}
{{- if and (lt (int $d.wave) (int $c.wave)) (gt (int $d.wave) $prev) }}{{ $prev = int $d.wave }}{{ end }}
{{- end }}
{{- $path := get "path" "" $c }}
{{- $repo := get "repo" "" $c }}
{{- $values := get "values" "" $c }}
{{- $route := get "canaryRoute" "" $c }}
{{- $service := eq $path "deploy/helm/svp-service" }}
{{- $canary := false }}
{{- if $service }}
{{- $canary = regexMatch "(?m)^canary: true$" (readFile (printf "%s/%s" $gitops $values)) }}
{{- if and $canary (not $route) }}
{{- fail (printf "%s sets canary: true, but component %s has no canaryRoute in argocd/apps/components.json" $values $c.name) }}
{{- end }}
{{- if and (not $canary) $route }}
{{- fail (printf "component %s has canaryRoute %s in argocd/apps/components.json, but %s does not set canary: true" $c.name $route $values) }}
{{- end }}
{{- end }}
  - name: {{ $c.name }}
    namespace: {{ $c.namespace }}
    labels:
      wave: {{ $c.wave | quote }}
{{- if $path }}
    chart: ../../{{ $path }}
{{- else if hasPrefix "oci://" $repo }}
    chart: {{ $repo }}/{{ $c.chart }}
    version: {{ $c.version | quote }}
{{- else }}
    chart: {{ $c.name }}/{{ $c.chart }}
    version: {{ $c.version | quote }}
{{- end }}
{{- $needs := list }}
{{- range $d := $dev }}
{{- if eq (int $d.wave) $prev }}
{{- $needs = append $needs (printf "%s/%s" $d.namespace $d.name) }}
{{- end }}
{{- /* Reloader's chart grants its Roles patch on Rollouts only when the cluster serves their API as Helm renders it
(isArgoRollouts of base/reloader.yaml), and argo-rollouts of the same wave brings that CRD: without this, a new
cluster would get a Reloader that cannot restart the gateway or the web client. */}}
{{- if and (eq $c.name "reloader") (eq $d.name "argo-rollouts") (le (int $d.wave) (int $c.wave)) }}
{{- $needs = append $needs (printf "%s/%s" $d.namespace $d.name) }}
{{- end }}
{{- end }}
{{- with $needs | uniq }}
    needs:
{{- range . }}
      - {{ . }}
{{- end }}
{{- end }}
{{- $arch_values := get (printf "archValues.%s" $arch) "" $c }}
{{- if or $values $arch_values }}
    values:
{{- with $values }}
      - {{ $gitops }}/{{ . }}
{{- end }}
{{- with $arch_values }}
      - {{ $gitops }}/{{ . }}
{{- end }}
{{- end }}
{{- if eq $c.name "svp-cluster" }}
    # Takes over the platform namespaces svp-cluster makes (so Pod Security is enforced before their chart's first pod)
    # and the project's that install.sh made, with the same labels: Helm refuses an existing object that lacks its
    # release's annotations unless told to take it over. Every object svp-cluster renders is the project's own, under a
    # name no other chart uses.
    takeOwnership: true
{{- end }}
{{- if eq $c.name "svp-policy" }}
    # The dev path runs unsigned images of the local registry: the image policy only reports what it would refuse, in
    # PolicyReports of namespace svp, and lets every pod through when Kyverno is down (failurePolicy Ignore). The GitOps
    # path keeps the values file's Enforce.
    set:
      - name: imageVerification.mode
        value: Audit
{{- end }}
{{- if and (eq $c.name "svp-data") $pgServer }}
    # Keeps the archive generation of the running Cluster svp-pg (pg_backup_sets of deploy/k8s/rotate.sh says why).
    setString:
      - name: postgres.backup.serverName
        value: {{ $pgServer | quote }}
{{- end }}
{{- if eq $c.name "otel-collector" }}
    # The Collector mounts ConfigMap otel-collector-config of chart svp-observability, which its own chart cannot
    # checksum, and reads it only when it starts: the checksum of the files that ConfigMap is made of (the shared
    # one, then each platform's destination file, concatenated) goes into the pod template, so a changed config rolls
    # the pod and an unchanged one does not.
    setString:
      - name: podAnnotations.svp-config-sha256
        value: {{ print (readFile "../observability/otelcol/k8s-config.yaml") (readFile "../observability/otelcol/k8s-k3d.yaml") (readFile "../observability/otelcol/k8s-eks.yaml") | sha256sum | quote }}
{{- end }}
{{- if $service }}
{{- with getOrNil $c.name $images }}
    # The image of make k8s-up, never written to a file of the repository.
    set:
      - name: image.repository
        value: {{ .repository | quote }}
      - name: image.tag
        value: {{ .tag | quote }}
      - name: image.digest
        value: {{ .digest | quote }}
{{- end }}
{{- if $canary }}
    # Client-side apply for a release with canary set (the gateway, the web client): Argo Rollouts writes the Services'
    # selectors and the HTTPRoute's weights, atomic fields that Helm 4's server-side apply sends whole and fails on. A
    # client-side upgrade patches only what changed, so an unchanged Service or route stays as the controller set it.
    # Helm's --wait never sees the Rollout as ready: the postsync hook waits for it.
    serverSide: "false"
    wait: false
{{- end }}
{{- end }}
    hooks:
      - events: [presync, postsync]
        showlogs: true
        command: ./install.sh
        args:
          - hook
          - '{{`{{ .Event.Name }}`}}'
          - {{ $c.name }}
          - {{ $c.namespace }}
          - {{ if $service }}service{{ else }}component{{ end }}
          - {{ $route | quote }}
          - '{{`{{ if .Event.Error }}failed{{ end }}`}}'
{{- end }}
