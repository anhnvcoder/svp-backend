    {
      "type": "timeseries",
      "title": "Burn rate by window",
      "description": "Error ratio of each window / error budget of public-uptime. Page: 5 m and 1 h > 14.4, or 30 m and 6 h > 6; ticket: 2 h and 1 d > 3, or 6 h and 3 d > 1.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (sloth_window) (slo:sli_error:ratio_rate5m{sloth_service=\"svp\", sloth_slo=\"public-uptime\"} or slo:sli_error:ratio_rate30m{sloth_service=\"svp\", sloth_slo=\"public-uptime\"} or slo:sli_error:ratio_rate1h{sloth_service=\"svp\", sloth_slo=\"public-uptime\"} or slo:sli_error:ratio_rate2h{sloth_service=\"svp\", sloth_slo=\"public-uptime\"} or slo:sli_error:ratio_rate6h{sloth_service=\"svp\", sloth_slo=\"public-uptime\"} or slo:sli_error:ratio_rate1d{sloth_service=\"svp\", sloth_slo=\"public-uptime\"} or slo:sli_error:ratio_rate3d{sloth_service=\"svp\", sloth_slo=\"public-uptime\"}) / on () group_left max(slo:error_budget:ratio{sloth_service=\"svp\", sloth_slo=\"public-uptime\"})",
          "legendFormat": "{{sloth_window}}",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
