    {
      "type": "timeseries",
      "title": "Compute cost per hour by namespace",
      "description": "Compute only: CPU and memory allocated to containers, priced per node by OpenCost; no EBS, network or managed services (RDS, MSK, ElastiCache, CloudFront), which Cost Explorer holds. Stacked; the legend shows the last and the highest value in the range. No data on compose (no OpenCost).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (namespace) (namespace:svp_compute_cost_usd_per_hour:sum{namespace=~\"$namespace\"})",
          "legendFormat": "{{namespace}}",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
