# Only the paths below have an owner, who must approve a pull request that changes them (ruleset owners). Every other
# file has no owner, so the pull requests Renovate merges by itself (renovate.json) never touch an owned path. The last
# matching line wins.
/CODEOWNERS               @anhnvcoder
/.github/                 @anhnvcoder
/renovate.json            @anhnvcoder
/release-please-config.json @anhnvcoder
/.release-please-manifest.json @anhnvcoder
/Makefile                 @anhnvcoder
/.trivyignore.yaml        @anhnvcoder
/.grype.yaml              @anhnvcoder
/.govulncheck-ignore.json @anhnvcoder
/deploy/ci/               @anhnvcoder
/tools/vulngate/          @anhnvcoder
/deploy/helm/svp-policy/  @anhnvcoder
