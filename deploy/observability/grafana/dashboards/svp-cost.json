  "panels": [
    {
      "type": "row",
      "title": "Cluster (USD per hour, compute)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Cluster node cost per hour",
      "description": "Sum of the hourly price of every node (OpenCost node_total_hourly_cost). stg nodes are Spot and OpenCost has no Spot data feed here, so stg figures are estimates. No data on compose (no OpenCost).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "cluster:svp_node_cost_usd_per_hour:sum",
          "legendFormat": "cluster",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "justifyMode": "auto"
      },
      "id": 2,
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Allocated to namespaces per hour",
      "description": "Compute only: CPU and memory allocated to containers, priced per node by OpenCost; no EBS, network or managed services (RDS, MSK, ElastiCache, CloudFront), which Cost Explorer holds. Sum over all namespaces of the allocated container cost. No data on compose (no OpenCost).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(namespace:svp_compute_cost_usd_per_hour:sum)",
          "legendFormat": "allocated",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "justifyMode": "auto"
      },
      "id": 3,
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Idle per hour",
      "description": "Node cost not allocated to any container: cluster cost minus the sum over namespaces, never below 0. High idle means requests are far below node size. No data on compose (no OpenCost).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "clamp_min(cluster:svp_node_cost_usd_per_hour:sum - on () sum(namespace:svp_compute_cost_usd_per_hour:sum), 0)",
          "legendFormat": "idle",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "justifyMode": "auto"
      },
      "id": 4,
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Monthly estimate (× 730 h)",
      "description": "Cluster node cost per hour × 730 hours. A projection if the cluster ran all month; the lab runs a few hours per session. stg nodes are Spot and OpenCost has no Spot data feed here, so stg figures are estimates. No data on compose (no OpenCost).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
