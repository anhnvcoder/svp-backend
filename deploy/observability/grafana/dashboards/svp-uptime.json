    {
      "type": "stat",
      "title": "Days until certificate expiry",
      "description": "Earliest certificate in the chain the probe saw. Ticket below 21 days, page below 7: renewal has failed (ACM renews 60 days before, cert-manager at one third of life left). The k3d probe skips chain verification but still reads the date. No data on compose (plain HTTP).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "min by (probe) (probe_ssl_earliest_cert_expiry{job=\"blackbox-http\", probe=~\"$probe\"} - time()) / 86400",
          "legendFormat": "{{probe}}",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 7
              },
              {
                "color": "green",
                "value": 21
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
