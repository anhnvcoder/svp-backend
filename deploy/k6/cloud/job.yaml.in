# Template of the k6 Job of the cloud cluster, filled in by render.sh. Not a manifest on its own (hence .yaml.in).
# Namespace svp-load: outside svp, so no Kyverno image policy, PSA restricted; Envoy's NetworkPolicy admits it by name.
# Up to 20 pods (render.sh --pods) of one Indexed Job, each on its own segment of profile cloud: k6 splits the rates.
# Design notes: docs/reference/compose.md.
apiVersion: v1
kind: Namespace
metadata:
  name: svp-load
  labels:
    pod-security.kubernetes.io/enforce: restricted
    pod-security.kubernetes.io/warn: restricted
---
apiVersion: batch/v1
kind: Job
metadata:
  name: svp-k6
  namespace: svp-load
spec:
  completionMode: Indexed
  # 20 is `pods` of profile cloud in lib/config.js; fewer pods set SVP_K6_PODS, and setup() refuses a run with another
  # number of segments. Each pod registers its own pool from its own pod IP (no rate limit key is ever deleted on the
  # cloud).
  completions: @PODS@
  parallelism: @PODS@
  # A pod run again would register its pool again: a failed pod is a result to read, not to retry. The limit is per
  # index so that one pod failing (k6 exits 99 on a threshold it missed) does not end the Job, which would make the
  # Job controller delete the pods still running before they print their summary; the Job ends, Failed if any index
  # failed, once every index has finished.
  backoffLimitPerIndex: 0
  # The whole run with room, so that a stuck run ends here: by default 3600 s for the profile's 10 min ramp, 10 min
  # hold and 1 min down; with render.sh --ramp or --hold, ramp + hold + 1 min down + 15 min for the pods to be pulled
  # and scheduled, setup() (3 min at most) and the summary.
  activeDeadlineSeconds: @DEADLINE@
  template:
    metadata:
      labels:
        app.kubernetes.io/name: svp-k6
    spec:
      restartPolicy: Never
      automountServiceAccountToken: false
      enableServiceLinks: false
      securityContext:
        runAsNonRoot: true
        # The k6 user of the image.
        runAsUser: 12345
        runAsGroup: 12345
        seccompProfile:
          type: RuntimeDefault
      # The public names point at Envoy's ClusterIP, so TLS checks the real certificate while the load never crosses the
      # public load balancer or the internet.
      hostAliases:
        - ip: "@ENVOY_IP@"
          hostnames: ["api.@DOMAIN@", "@DOMAIN@"]
      containers:
        - name: k6
          image: "@K6_IMAGE@"
          command: ["sh", "-c"]
          # Pod i of N runs segment i/N:(i+1)/N of an even sequence. $$ keeps Kubernetes from reading $(( )) as a
          # reference to a variable.
          args:
            - |
              i=$JOB_COMPLETION_INDEX
              seq=0; n=1
              while [ "$n" -lt @PODS@ ]; do seq="$seq,$n/@PODS@"; n=$$((n + 1)); done
              exec k6 run --quiet --include-system-env-vars \
                --execution-segment "$i/@PODS@:$$((i + 1))/@PODS@" --execution-segment-sequence "$seq,1" /scripts/main.js
          env:
            - name: SVP_K6_PROFILE
              value: cloud
            - name: SVP_API_URL
              value: "https://api.@DOMAIN@"
            - name: SVP_WEB_URL
              value: "https://@DOMAIN@"
            - name: SVP_WEB_ORIGIN
              value: "https://@DOMAIN@"
            - name: SVP_K6_PODS # @PODS@
              value: "@PODS@" # @PODS@
            - name: SVP_K6_RAMP # @RAMP@
              value: "@RAMP@" # @RAMP@
            - name: SVP_K6_HOLD # @HOLD@
              value: "@HOLD@" # @HOLD@
            # The pod calls Envoy past CloudFront, so it writes the viewer address CloudFront would: its own IP, one
            # rate limit bucket per pod (threat model RL-7).
            - name: SVP_K6_VIEWER_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
            - name: K6_NO_USAGE_REPORT
              value: "true"
            - name: K6_AUTO_EXTENSION_RESOLUTION
              value: "false"
            - name: SSL_CERT_FILE # @CA@
              value: /etc/svp-k6-ca/ca.crt # @CA@
          resources:
            requests:
              cpu: "1"
              memory: 256Mi
            limits:
              memory: 1Gi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: scripts
              mountPath: /scripts
              readOnly: true
            - name: ca # @CA@
              mountPath: /etc/svp-k6-ca # @CA@
              readOnly: true # @CA@
      volumes:
        - name: scripts
          configMap:
            name: svp-k6-scripts
            items: @SCRIPT_ITEMS@
        - name: ca # @CA@
          configMap: # @CA@
            name: svp-k6-ca # @CA@
